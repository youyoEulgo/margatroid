{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["server"],
  "properties": {
    "alias_prefix": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
      "maxLength": 64,
      "description": "Prefix prepended to each remote tool name; defaults to mcp_. Non-identifier bytes in remote names become underscores. Collisions fail the whole registration."
    },
    "server": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "command"],
          "properties": {
            "transport": {"const": "stdio"},
            "command": {"type": "string", "minLength": 1},
            "args": {"type": "array", "items": {"type": "string"}},
            "env": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "url"],
          "properties": {
            "transport": {"const": "http"},
            "url": {"type": "string", "pattern": "^https?://", "minLength": 8},
            "headers": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      ]
    }
  }
}
