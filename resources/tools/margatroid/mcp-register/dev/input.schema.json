{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["server"],
  "properties": {
    "alias_prefix": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
      "maxLength": 64,
      "description": "Prefix prepended to remote tool names and the generated update tool; defaults to mcp_. Non-identifier bytes in remote names become underscores. The suffix update is reserved for replacing this MCP connection. Collisions fail the whole registration. Updating replaces the complete server configuration and uses the new prefix (mcp_ if omitted)."
    },
    "server": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "command"],
          "properties": {
            "transport": {"const": "stdio"},
            "command": {"type": "string", "minLength": 1},
            "args": {"type": "array", "items": {"type": "string"}},
            "env": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "url"],
          "properties": {
            "transport": {"const": "http"},
            "url": {"type": "string", "pattern": "^https?://", "minLength": 8},
            "headers": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      ]
    }
  }
}
